[Unit]
Description=LinTech Panel Worker
Requires=lintech-agent.service
After=lintech-api.service lintech-agent.service

[Service]
User=lintech
Group=lintech
WorkingDirectory=/opt/lintech-panel
EnvironmentFile=/etc/lintech-panel/panel.env
Environment=LINTECH_AGENT_SOCKET=/run/lintech-panel/agent.sock
ExecStart=/usr/bin/node /opt/lintech-panel/worker/src/worker.js
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lintech-panel
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
