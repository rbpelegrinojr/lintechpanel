[Unit]
Description=LinTech Panel API
After=network.target

[Service]
User=lintech
Group=lintech
WorkingDirectory=/opt/lintech-panel
EnvironmentFile=/etc/lintech-panel/panel.env
ExecStart=/usr/bin/node --jitless /opt/lintech-panel/backend/src/server.js
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lintech-panel
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
