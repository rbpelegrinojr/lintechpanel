[Unit]
Description=LinTech Panel Privileged Agent
After=network.target php8.3-fpm.service
Wants=php8.3-fpm.service

[Service]
User=root
Group=root
WorkingDirectory=/opt/lintech-panel
Environment=LINTECH_AGENT_SOCKET=/run/lintech-panel/agent.sock
Environment=LINTECH_AGENT_GROUP=lintech
ExecStart=/bin/sh -c 'LINTECH_AGENT_SECRET=$(cat /etc/lintech-panel/agent.secret) exec /usr/bin/node /opt/lintech-panel/agent/src/agent.js'
ExecStartPost=/bin/chgrp lintech /run/lintech-panel/agent.sock
ExecStartPost=/bin/chmod 0660 /run/lintech-panel/agent.sock
Restart=on-failure
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# nginx -t updates this fixed PID file even though it does not reload the daemon.
# nginx -t also opens these standard log files while parsing sites.
ReadWritePaths=/run/lintech-panel /run/php /run/nginx.pid /home /etc /var/lib/letsencrypt /var/log/letsencrypt /var/log/nginx/error.log /var/log/nginx/access.log
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID

[Install]
WantedBy=multi-user.target
